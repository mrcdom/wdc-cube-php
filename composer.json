{
    "name": "wedocode/wdc-cube-php",
    "description": "Cube MVP in PHP: server-side presenters, thin client over WebSocket — with the Store demo application",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "ext-gmp": "*",
        "ext-openssl": "*",
        "ext-pgsql": "*",
        "amphp/http-client": "^5.3",
        "amphp/http-server": "^3.4",
        "amphp/http-server-router": "^2.0",
        "amphp/http-server-static-content": "^2.0",
        "amphp/postgres": "^2.2",
        "amphp/websocket-server": "^4.0",
        "psr/log": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Wdc\\Framework\\": "src/Framework/",
            "Wdc\\Store\\": "src/Store/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wdc\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "check": ["@analyse", "@test"]
    },
    "config": {
        "sort-packages": true
    },
    "require-dev": {
        "amphp/websocket-client": "^2.0",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13.4"
    }
}
